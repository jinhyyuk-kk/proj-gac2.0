<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Gac.Tray</AssemblyName>
    <RootNamespace>Gac.Tray</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icons\gac.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gac.Shared\Gac.Shared.csproj" />
    <ProjectReference Include="..\Gac.Tray.UI\Gac.Tray.UI.csproj" />
    <ProjectReference Include="..\Gac.Modules.ClassMode\Gac.Modules.ClassMode.csproj" />
    <ProjectReference Include="..\Gac.Modules.NetDiag\Gac.Modules.NetDiag.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gac.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

</Project>
