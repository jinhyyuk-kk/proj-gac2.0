<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>2.0.0</Version>
    <Company>JH</Company>
    <Product>GAC 2.0</Product>
    <Copyright>Copyright (c) 2026 JH</Copyright>
    <SatelliteResourceLanguages>ko;en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1416;CS0649;WFO1000</NoWarn>
  </PropertyGroup>
</Project>
